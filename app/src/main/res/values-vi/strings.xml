    <string name="privacy_offline">Lifepoints hoạt động không cần mạng. Ứng dụng không có quyền truy cập internet và không bao giờ kết nối đến bất cứ đâu.</string>
    <string name="privacy_data_title">Dữ liệu của bạn</string>
    <string name="privacy_data">Trò chơi và cài đặt chỉ được lưu trên điện thoại này và bị xóa khi bạn gỡ ứng dụng. Không có gì được thu thập, gửi đi hay chia sẻ với bên thứ ba.</string>
    <string name="privacy_permissions_title">Quyền</string>
    <string name="privacy_permissions">Ứng dụng không yêu cầu quyền nào.</string>
    <string name="privacy_links_title">Liên kết</string>
    <string name="privacy_links">Địa chỉ liên hệ chỉ mở ứng dụng email của bạn hoặc sao chép địa chỉ. Tiền boa chỉ hiển thị một mã để quét bằng điện thoại khác. Những gì diễn ra ở đó nằm ngoài ứng dụng này.</string>
    <string name="terms_free_title">Miễn phí và không bảo hành</string>
    <string name="terms_free">Lifepoints miễn phí và được cung cấp nguyên trạng, không có bảo hành. Tiền boa là tự nguyện và không mở khóa gì.</string>
    <string name="terms_liability_title">Trách nhiệm</string>
    <string name="terms_liability">Trong phạm vi pháp luật cho phép, nhà phát triển (%1$s, %2$s) không chịu trách nhiệm về thiệt hại do việc sử dụng ứng dụng. Các quyền hợp pháp của người tiêu dùng không bị ảnh hưởng.</string>
    <string name="licenses_intro">Lifepoints được xây dựng với các thành phần nguồn mở sau:</string>
    <string name="license_text">Nội dung giấy phép: %1$s</string>
    <string name="legal_notes">Lifepoints là ứng dụng độc lập. Ứng dụng không liên kết hay được bảo trợ bởi bất kỳ nhà phát hành trò chơi thẻ bài sưu tập nào và không chứa nhãn hiệu của bên thứ ba.</string>
    <string name="tip_jar_text">Bạn thích Lifepoints? Quét mã bằng điện thoại khác để gửi tiền boa trên Ko-fi. Tiền boa là tự nguyện và không mở khóa gì.</string>
