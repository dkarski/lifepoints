    <string name="privacy_permissions">The app asks for no permissions.</string>
    <string name="privacy_links_title">Links</string>
    <string name="privacy_links">The contact address only opens your e-mail app or copies the address. The Tip jar only shows a code to scan with another phone. What happens there is outside this app.</string>
